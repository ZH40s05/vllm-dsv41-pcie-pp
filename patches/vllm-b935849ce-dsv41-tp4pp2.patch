@@ -122,6 +122,20 @@ def get_pipeline_boundaries(
     return tuple(boundaries)
 
 
+def decoder_replay_partition_error(
+    start_layer: int, end_layer: int, num_layers: int, cut: int
+) -> str | None:
+    """Replay requires a local mHC predecessor and every layer from cut onward."""
+    if start_layer > cut or end_layer < num_layers:
+        return (
+            "the pipeline stage holding the last KV source layer must also "
+            "hold every layer after it"
+        )
+    if start_layer == cut:
+        return "the last KV source is the first layer of its pipeline stage"
+    return None
+

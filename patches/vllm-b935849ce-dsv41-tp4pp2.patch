+        (20, 40, "first layer of its pipeline stage"),
+        (0, 26, "hold every layer after it"),
+    ],
+)
+def test_decoder_replay_requires_local_predecessor_and_tail(
+    pipeline_module, flash_sharing_config, start, end, expected_error
+):
+    config = flash_sharing_config
+    cut = max(config.kv_source_layer_ids)
+    reason = pipeline_module.decoder_replay_partition_error(
+        start, end, config.num_hidden_layers, cut
+    )
+    if expected_error is None:
+        assert reason is None
+    else:
+        assert reason is not None and expected_error in reason
+
